            "url": {
              "raw": "{{baseUrl}}/api/questions/{{questionId}}/answers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "questions", "{{questionId}}", "answers"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"respondentName\": \"Enes Orhan\",\n  \"value\": \"Evet\"\n}"
            },
            "description": "Anket aktifken çalışır. Pasif ankette 409 Conflict döner."
          }
        },
        {
          "name": "7. Get answers by question",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/questions/{{questionId}}/answers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "questions", "{{questionId}}", "answers"]
            }
          }
        },
        {
          "name": "7b. Get answer by id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/answers/{{answerId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "answers", "{{answerId}}"]
            }
          }
        },
        {
          "name": "8. Update answer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('204 No Content', () => pm.response.to.have.status(204));"]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/answers/{{answerId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "answers", "{{answerId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"respondentName\": \"Enes Orhan\",\n  \"value\": \"Kısmen\"\n}"
            }
          }
        },
        {
          "name": "Delete answer (opsiyonel)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('204 No Content', () => pm.response.to.have.status(204));"]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/answers/{{answerId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "answers", "{{answerId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Hata senaryoları",
      "item": [
        {
          "name": "11. Create answer — pasif anket (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 Conflict', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/questions/{{questionId}}/answers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "questions", "{{questionId}}", "answers"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"respondentName\": \"Test\",\n  \"value\": \"Hayır\"\n}"
            },
            "description": "'Update survey (pasife alır)' isteğinden SONRA çalıştırın; anket pasif olduğu için 409 döner."
          }
        },
        {
          "name": "12. Create survey — boş title (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('400 Bad Request', () => pm.response.to.have.status(400));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/surveys", "host": ["{{baseUrl}}"], "path": ["api", "surveys"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"\",\n  \"isActive\": true\n}"
            },
            "description": "title zorunlu olduğu için DataAnnotations doğrulaması 400 döndürür."
          }
        },
        {
          "name": "Get survey — olmayan id (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('404 Not Found', () => pm.response.to.have.status(404));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/surveys/00000000-0000-0000-0000-000000000000",
              "host": ["{{baseUrl}}"],
              "path": ["api", "surveys", "00000000-0000-0000-0000-000000000000"]
            }
          }
        }
      ]
    }
  ]
}
